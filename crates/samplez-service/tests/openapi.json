{
  "components": {
    "schemas": {
      "AuthMode": {
        "enum": [
          "none",
          "token",
          "proxy",
          "oidc"
        ],
        "type": "string"
      },
      "Login": {
        "properties": {
          "token": {
            "type": "string"
          }
        },
        "required": [
          "token"
        ],
        "type": "object"
      },
      "Logout": {
        "properties": {
          "redirect": {
            "description": "Where the browser goes next to end its session at the identity\nprovider too; `oidc` mode with a provider that has an end-session\nendpoint only.",
            "type": [
              "string",
              "null"
            ]
          }
        },
        "type": "object"
      },
      "Role": {
        "enum": [
          "viewer",
          "operator"
        ],
        "type": "string"
      },
      "Session": {
        "properties": {
          "mode": {
            "$ref": "#/components/schemas/AuthMode"
          },
          "role": {
            "oneOf": [
              {
                "$ref": "#/components/schemas/Role",
                "description": "`None` when not signed in."
              },
              {
                "type": "null"
              }
            ]
          },
          "user": {
            "description": "`None` when not signed in, in `none` mode and for a static token.",
            "type": [
              "string",
              "null"
            ]
          }
        },
        "required": [
          "mode"
        ],
        "type": "object"
      },
      "Status": {
        "properties": {
          "revision": {
            "format": "int64",
            "minimum": 0,
            "type": "integer"
          }
        },
        "required": [
          "revision"
        ],
        "type": "object"
      }
    },
    "securitySchemes": {
      "bearer": {
        "scheme": "bearer",
        "type": "http"
      },
      "session": {
        "in": "cookie",
        "name": "samplez_session",
        "type": "apiKey"
      }
    }
  },
  "info": {
    "description": "Listeners, auth, ops endpoints and WebSocket fan-out shared by samplez products",
    "license": {
      "identifier": "Apache-2.0",
      "name": "Apache-2.0"
    },
    "title": "example",
    "version": "0.0.0"
  },
  "openapi": "3.1.0",
  "paths": {
    "/api/v1/login": {
      "post": {
        "operationId": "login",
        "parameters": [
          {
            "description": "Must be 1",
            "in": "header",
            "name": "X-Samplez-Request",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/Login"
              }
            }
          },
          "required": true
        },
        "responses": {
          "204": {
            "description": "Session cookie set for 12 h"
          },
          "401": {
            "description": "Wrong token"
          },
          "403": {
            "description": "Host not allowed or request header missing"
          }
        },
        "security": [
          {}
        ],
        "summary": "Exchanges the API token for a session cookie; `token` mode only.",
        "tags": [
          "auth"
        ]
      }
    },
    "/api/v1/logout": {
      "post": {
        "operationId": "logout",
        "parameters": [
          {
            "description": "Must be 1",
            "in": "header",
            "name": "X-Samplez-Request",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Logout"
                }
              }
            },
            "description": "Session cookie cleared"
          },
          "403": {
            "description": "Host not allowed or request header missing"
          }
        },
        "security": [
          {}
        ],
        "summary": "Clears the session cookie and ends the session on this process, for\nany copy of the cookie and the WebSockets opened with it; `token` and\n`oidc` mode.",
        "tags": [
          "auth"
        ]
      }
    },
    "/api/v1/session": {
      "get": {
        "operationId": "session",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Session"
                }
              }
            },
            "description": "The mode and the identity, if any"
          },
          "403": {
            "description": "Host not allowed"
          }
        },
        "security": [
          {}
        ],
        "summary": "Who the request is authenticated as. Answered without credentials as\nwell, with no role, so a client learns how to sign in: in `oidc` mode\nat `GET /login`, in `token` mode with `POST /login`.",
        "tags": [
          "auth"
        ]
      }
    },
    "/api/v1/status": {
      "get": {
        "operationId": "status",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Status"
                }
              }
            }
          }
        },
        "summary": "Only the OpenAPI path generated from it is used.",
        "tags": [
          "example"
        ]
      }
    }
  },
  "security": [
    {
      "bearer": []
    },
    {
      "session": []
    }
  ]
}
